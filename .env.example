# Copy to .env (git-ignored) and adjust. These defaults are for local development only.
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
POSTGRES_PORT=5432

# Needed by the "app" profile (docker compose --profile app up -d --build).
# These are PLACEHOLDERS: put your own long random values in your .env.
JWT_SECRET=change-me-to-at-least-32-random-characters
FAKEPAY_WEBHOOK_SECRET=change-me-to-at-least-32-random-characters
# the first administrator, created on startup if none exists (needed to create organizers)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# optional: PUBLIC_BASE_URL=http://localhost:8080
# optional: CORS_ALLOWED_ORIGINS=http://localhost:5173
# optional (without the compose app): MAIL_HOST=smtp.example.com, MAIL_PORT=587
